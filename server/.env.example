# --- Reasoning LLM (DeepSeek, OpenAI-compatible endpoint) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Speech-to-Speech (NVIDIA) ---
# Leave NVIDIA_API_KEY blank to run the offline synthetic-audio fallback.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_STS_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_STS_MODEL=nvidia/speech-to-speech
NVIDIA_VOICE_NAME=en-US-Standard-A
NVIDIA_STS_SAMPLE_RATE=16000

# --- RAG vector store (Postgres + pgvector) ---
# Local docker-compose: postgresql://interview:interview@localhost:5432/interview
# Supabase (password ending in '@' must be URL-encoded as %40):
#   postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview

# --- Application data (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=interview
